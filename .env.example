# ─── Database ─────────────────────────────────────────────────
POSTGRES_USER=fluently
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=fluently_dev
DATABASE_URL=postgresql://fluently:change_me_in_production@localhost:5432/fluently_dev

# ─── Redis ────────────────────────────────────────────────────
REDIS_PASSWORD=change_me_in_production
REDIS_URL=redis://:change_me_in_production@localhost:6379

# ─── Auth ─────────────────────────────────────────────────────
JWT_SECRET=change_me_in_production_min_32_chars
JWT_REFRESH_SECRET=change_me_in_production_min_32_chars
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d

# ─── OAuth ────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_PRIVATE_KEY_PATH=

# ─── Next.js ──────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000/v1
NEXT_PUBLIC_WS_URL=ws://localhost:4000

# ─── NestJS ───────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── Turbo Remote Cache (optional) ───────────────────────────
TURBO_TOKEN=
TURBO_TEAM=

# ─── Monitoring ───────────────────────────────────────────────
SENTRY_DSN=
CODECOV_TOKEN=
